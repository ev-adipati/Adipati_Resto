<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F6F8"
    android:gravity="center_horizontal">

    <!-- Ikon dan Pesan Sukses -->
    <ImageView
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@android:drawable/ic_dialog_info"
        app:tint="#4CAF50"
        android:layout_marginBottom="12dp"
        android:layout_marginTop="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pesanan Berhasil Terkirim!"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:textColor="#4CAF50"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sistem dapur Adipati Resto telah menerima pesanan Anda dan sedang menyiapkannya."
        android:textSize="14sp"
        android:textAlignment="center"
        android:textColor="#78909C"
        android:layout_marginBottom="24dp"/>

    <!-- Kartu Struk -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        android:backgroundTint="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ID Pesanan: #ORD-00000"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textColor="#F4511E"
                android:layout_marginBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvReceiptDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Detail pesanan..."
                android:textSize="16sp"
                android:textColor="#455A64"
                android:lineSpacingExtra="4dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Silakan lakukan pembayaran di kasir\ndengan menyebutkan ID Pesanan Anda."
                android:textAlignment="center"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#263238"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnBackToMenu"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="32dp"
        android:text="Kembali ke Menu Utama"
        android:textColor="#FFFFFF"
        android:backgroundTint="#F4511E"
        app:cornerRadius="25dp"/>
</LinearLayout>